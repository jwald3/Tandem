# Copy to .env and fill in, or just export these in your shell.

# Enables the chat assistant. Bring your own key from https://console.anthropic.com
# Leave unset to run without it (or paste a key in the app instead).
ANTHROPIC_API_KEY=

# Listen address (default 127.0.0.1:8090, this computer only)
# ADDR=127.0.0.1:8090
# To reach the app from other devices on your network, use ADDR=:8090.
# There is no login, so only do that on a network you trust.

# SQLite database file (default tandem.db, created on first run)
# DB_PATH=tandem.db
